/*******************************************************************************
 * ROFI DEFAULT CONFIG
 * Fallback for bare `rofi` calls — the themes/ files override this.
 *******************************************************************************/

configuration {
    modi:                   "drun";
    show-icons:             true;
    display-drun:           "";
    drun-display-format:    "{name}";
    font:                   "JetBrainsMono Nerd Font 11";
    hover-select:           true;
    me-select-entry:        "";
    me-accept-entry:        "MousePrimary";
}

@theme "/dev/null"
@import "themes/colors.rasi"

window {
    background-color:       @surface;
    border:                 1px;
    border-color:           @line;
    border-radius:          18px;
    width:                  520px;
    padding:                16px;
}

inputbar {
    background-color:       @raised;
    border-radius:          12px;
    padding:                12px 14px;
    margin:                 0 0 12px 0;
}

entry {
    text-color:             @fg;
    placeholder:            "search";
    placeholder-color:      @faint;
}

listview {
    lines:                  8;
    columns:                1;
    spacing:                2px;
    scrollbar:              false;
    fixed-height:           false;
}

element {
    padding:                9px 12px;
    spacing:                14px;
    border-radius:          10px;
    cursor:                 pointer;
}

element selected {
    background-color:       @selected;
    text-color:             @fg;
}

element-icon {
    size:                   24px;
}
