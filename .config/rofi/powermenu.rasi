/* Standalone powermenu theme used by .config/scripts/powermenu.sh
 * (icon + label entries; themes/powermenu.rasi is the icon-only variant). */

configuration {
    show-icons: false;
}

@theme "/dev/null"
@import "themes/colors.rasi"

window {
    width: 460px;
    background-color: @surface;
    border: 1px;
    border-color: @line;
    border-radius: 22px;
    padding: 26px;
    location: center;
    anchor: center;
}

listview {
    columns: 2;
    lines: 2;
    spacing: 14px;
    cycle: true;
    dynamic: true;
    layout: vertical;
}

element {
    orientation: vertical;
    padding: 20px;
    border-radius: 16px;
    background-color: @raised;
    cursor: pointer;
}

element selected {
    background-color: @selected;
    text-color: @fg;
}

element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
    font: "JetBrainsMono Nerd Font 12";
    background-color: inherit;
    text-color: inherit;
}
