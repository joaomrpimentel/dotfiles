/*******************************************************************************
 * CLIPBOARD MANAGER THEME
 *******************************************************************************/

configuration {
    show-icons:             false;
    font:                   "JetBrainsMono Nerd Font 11";
    hover-select:           true;
    me-select-entry:        "";
    me-accept-entry:        "MousePrimary";
}

@theme "/dev/null"
@import "colors.rasi"

window {
    background-color:       @surface;
    border:                 1px;
    border-color:           @line;
    border-radius:          18px;
    width:                  680px;
    location:               center;
    anchor:                 center;
}

mainbox {
    children:               [ inputbar, listview ];
    spacing:                14px;
    padding:                16px;
}

inputbar {
    children:               [ prompt, entry ];
    background-color:       @raised;
    border-radius:          12px;
    padding:                12px 14px;
    spacing:                10px;
}

prompt {
    text-color:             @faint;
}

entry {
    text-color:             @fg;
    placeholder:            "search clipboard";
    placeholder-color:      @faint;
    cursor:                 text;
}

listview {
    columns:                1;
    lines:                  10;
    spacing:                2px;
    cycle:                  true;
    dynamic:                true;
    layout:                 vertical;
    scrollbar:              false;
    fixed-height:           true;
}

element {
    padding:                8px 12px;
    border-radius:          8px;
    cursor:                 pointer;
}

element normal.normal,
element alternate.normal {
    text-color:             @dim;
}

element selected.normal {
    background-color:       @selected;
    text-color:             @fg;
}

element-text {
    text-color:             inherit;
    vertical-align:         0.5;
    horizontal-align:       0.0;
}
