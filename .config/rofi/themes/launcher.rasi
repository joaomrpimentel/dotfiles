/*******************************************************************************
 * APP LAUNCHER THEME
 *******************************************************************************/

configuration {
    modes:                  "combi,drun,run,calc";
    combi-modes:            "drun,calc";
    combi-display-format:   "{text}";
    show-icons:             true;
    display-drun:           "apps";
    display-run:            "run";
    display-calc:           "calc";
    display-combi:          "";
    drun-display-format:    "{name}";
    font:                   "JetBrainsMono Nerd Font 11";
    hover-select:           true;
    me-select-entry:        "";
    me-accept-entry:        "MousePrimary";
}

@theme "/dev/null"
@import "colors.rasi"

window {
    background-color:       @surface;
    border:                 1px;
    border-color:           @line;
    border-radius:          18px;
    width:                  520px;
    location:               center;
    anchor:                 center;
}

mainbox {
    children:               [ inputbar, listview ];
    spacing:                14px;
    padding:                16px;
}

inputbar {
    children:               [ prompt, entry ];
    background-color:       @raised;
    border-radius:          12px;
    padding:                12px 14px;
    spacing:                10px;
}

prompt {
    text-color:             @faint;
}

entry {
    text-color:             @fg;
    placeholder:            "search";
    placeholder-color:      @faint;
    cursor:                 text;
}

listview {
    columns:                1;
    lines:                  8;
    spacing:                2px;
    cycle:                  true;
    dynamic:                true;
    layout:                 vertical;
    scrollbar:              false;
    fixed-height:           true;
}

element {
    padding:                9px 12px;
    border-radius:          10px;
    spacing:                14px;
    cursor:                 pointer;
}

element normal.normal,
element normal.active,
element normal.urgent,
element alternate.normal,
element alternate.active,
element alternate.urgent {
    text-color:             @dim;
}

element selected.normal,
element selected.active {
    background-color:       @selected;
    text-color:             @fg;
}

element urgent {
    text-color:             @urgent;
}

element-icon {
    size:                   24px;
}

element-text {
    text-color:             inherit;
    vertical-align:         0.5;
    horizontal-align:       0.0;
}
