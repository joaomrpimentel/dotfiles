/*******************************************************************************
 * CONFIRMATION DIALOG THEME
 *******************************************************************************/

configuration {
    show-icons:             false;
    font:                   "JetBrainsMono Nerd Font 11";
}

@theme "/dev/null"
@import "colors.rasi"

window {
    background-color:       @surface;
    border:                 1px;
    border-color:           @line;
    border-radius:          14px;
    width:                  220px;
    location:               center;
    anchor:                 center;
    padding:                14px;
}

mainbox {
    children:               [ inputbar, listview ];
    spacing:                10px;
}

inputbar {
    children:               [ prompt ];
    padding:                4px;
}

prompt {
    text-color:             @urgent;
}

entry {
    enabled:                false;
}

listview {
    lines:                  2;
    columns:                1;
    spacing:                4px;
}

element {
    padding:                8px 14px;
    border-radius:          8px;
    cursor:                 pointer;
}

element selected.normal {
    background-color:       @selected;
    text-color:             @fg;
}

element-text {
    text-color:             inherit;
    horizontal-align:       0.5;
}
