/*******************************************************************************
 * POWERMENU THEME
 * Grid of large icon buttons.
 *******************************************************************************/

configuration {
    show-icons:             false;
    font:                   "JetBrainsMono Nerd Font 11";
    hover-select:           true;
    me-select-entry:        "";
    me-accept-entry:        "MousePrimary";
}

@theme "/dev/null"
@import "colors.rasi"

window {
    background-color:       @surface;
    border:                 1px;
    border-color:           @line;
    border-radius:          22px;
    width:                  400px;
    location:               center;
    anchor:                 center;
}

mainbox {
    children:               [ message, listview ];
    spacing:                18px;
    padding:                22px;
}

message {
    background-color:       transparent;
}

textbox {
    text-color:             @faint;
    horizontal-align:       0.5;
}

inputbar {
    enabled:                false;
}

listview {
    columns:                2;
    lines:                  2;
    spacing:                14px;
    cycle:                  true;
    dynamic:                true;
    layout:                 vertical;
    scrollbar:              false;
}

element {
    background-color:       @raised;
    padding:                30px 20px;
    border-radius:          16px;
    cursor:                 pointer;
}

element selected.normal {
    background-color:       @selected;
    text-color:             @fg;
}

element-text {
    text-color:             inherit;
    font:                   "JetBrainsMono Nerd Font 26";
    horizontal-align:       0.5;
    vertical-align:         0.5;
}
